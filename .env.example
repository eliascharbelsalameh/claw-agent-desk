# Copy to .env and fill in. Never commit the real .env - see claw_agent_spec.md
# section 2: anything in the challenge entry may end up public, so keep secrets
# and personal contact info out of anything that gets committed.

# Alpaca Market Data (free Basic plan, IEX feed) + paper trading account
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# FRED (macro data) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub (company news) - https://finnhub.io/dashboard
FINNHUB_API_KEY=

# SEC EDGAR has no API key but requires a descriptive User-Agent identifying
# the requester, e.g. "AppName contact@example.com". Required for every call.
SEC_EDGAR_USER_AGENT=

# Local disk cache directory (created automatically on first use)
DATA_LAYER_CACHE_DIR=.cache
